#!/bin/sh
#
# Lints the WHOLE workspace. A bare `cargo clippy` at the root only lints the
# root `fink-fat` package (the other members are merely built as
# dependencies), hence the explicit `--workspace` / `-p` everywhere below.
#
# `fink-fat-explorer` is a Dioxus fullstack app, linted the way `dx` builds it
# rather than with `--all-features` (its `desktop`/`mobile` features pull GTK
# and are never built here):
#   - `server` feature, host target, with tests;
#   - `web` feature, wasm32 target (the browser client).
# Each side has code the other compiles out (`#[cfg(feature = "server")]`
# helpers, `#[cfg(target_arch = "wasm32")]` plotting), so dead code only shows
# up when both are linted. Requires `rustup target add wasm32-unknown-unknown`.

EXPLORER_SERVER="-p fink-fat-explorer --no-default-features --features server"
EXPLORER_WEB="-p fink-fat-explorer --no-default-features --features web --target wasm32-unknown-unknown"

echo "Running cargo fmt..."
cargo fmt --all -- --check || exit 1

echo "Running cargo clippy (workspace, all features, explorer excluded)..."
cargo clippy --workspace --exclude fink-fat-explorer --all-targets --all-features -- -D warnings || exit 1

echo "Running cargo clippy (explorer, server)..."
cargo clippy $EXPLORER_SERVER --all-targets -- -D warnings || exit 1

echo "Running cargo clippy (explorer, web/wasm32)..."
cargo clippy $EXPLORER_WEB -- -D warnings || exit 1

echo "Running cargo check..."
cargo check --workspace --exclude fink-fat-explorer --all-targets --all-features || exit 1
cargo check $EXPLORER_SERVER --all-targets || exit 1
cargo check $EXPLORER_WEB || exit 1

echo "Checking documentation build..."
RUSTDOCFLAGS="-D warnings --html-in-header $(pwd)/katex-header.html" cargo doc --no-deps --all-features -p fink-fat -p fink-fat-engine || exit 1
