# Template of secrets.env — copy it, fill it in, and keep it private:
#   cp secrets.example.env secrets.env && chmod 600 secrets.env
# secrets.env is gitignored. ff-ops builds one .env per VM holding only what that VM needs
# (README.md, "Security"). Generate passwords with e.g.:  openssl rand -base64 24

# Postgres user password (db, compute, explorer). At least 12 characters.
POSTGRES_PASSWORD=

# pgAdmin web UI password (explorer, reachable only through `ff-ops tunnel pgadmin`).
PGADMIN_PASSWORD=

# SASL password of the Fink Kafka account. Leave empty if the account has none.
FINK_FAT_KAFKA_PASSWORD=

# GitHub token with read:packages. Only needed if the GHCR images are private.
GHCR_READ_TOKEN=
